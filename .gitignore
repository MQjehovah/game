build/
build-*/
*.o
*.obj
!assets/kenney_nature/**/*.obj
*.exe
*.pdb
*.ilk
# Engine-local derived data (offline-baked BC1 textures etc.) — regenerated on
# demand, never versioned. Analogous to Unity's Library/ or Godot's .godot/.
.neon/
# Runtime save games live next to the project while developing, but they are
# player data, not source data.
*_save.dat
projects/*/save.json
projects/*/save.json.meta
neon_editor_config.json
editor_scene.json
scenes/
# ...but project scenes are first-class project data (2D levels now live in
# assets/scenes/*.json too), so keep them under version control.
projects/*
!projects/snake/
!projects/snake/**
# NeonPhysics rigid-body demo project
!projects/physics_demo/
!projects/physics_demo/**
# NeonPvZ architecture-showcase project: everything under its assets/ content
# root (scenes, scripts, prefabs, UI docs, locales, sprites, audio), the input
# map and plugins are all first-class project data.
!projects/pvz/
!projects/pvz/**
.vs/
.vscode/
CMakeUserPresets.json
# Shadow-map / screenshot debug artifacts (throwaway diagnostics)
*.raw
*.png
!projects/pvz/assets/sprites/*.png
